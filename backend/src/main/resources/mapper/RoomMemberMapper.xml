<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tomato.studyroom.mapper.RoomMemberMapper">
    
    <select id="selectMembersByRoomId" resultType="com.tomato.studyroom.entity.RoomMember">
        SELECT * FROM roommember
        WHERE room_id = #{roomId}
        ORDER BY joined_at ASC
    </select>
    
    <select id="countActiveMembersByRoomId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM roommember
        WHERE room_id = #{roomId}
          AND status IN ('专注中', 'active')
    </select>
    
</mapper>
